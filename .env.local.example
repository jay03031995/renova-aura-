# ----------------------------------------------------------------------------
# Sanity (admin panel at /studio)
# ----------------------------------------------------------------------------
# After creating a project at https://www.sanity.io/manage:
#   1. Copy the Project ID from the project page.
#   2. Use the default dataset name (production) unless you changed it.
#   3. Create a server-only API token with permission to create lead documents
#      (and read published content if CMS pages should render from Sanity).
#      Never expose it client-side or commit it.
# ----------------------------------------------------------------------------

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-11-01

# Server-only — never commit a real value here.
SANITY_API_TOKEN=

# Shared secret for the Sanity → /api/revalidate webhook. Generate any random
# string (`openssl rand -hex 32`) and paste the same value into the Sanity
# webhook config at sanity.io/manage/project/<id>/api/webhooks.
SANITY_REVALIDATE_SECRET=

# Separate secret for the Create-only Sanity lead notification webhook.
# Do not reuse SANITY_REVALIDATE_SECRET.
SANITY_LEAD_WEBHOOK_SECRET=
# Email delivery for signed lead notifications (Resend).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SANITY_LEAD_NOTIFICATION_EMAIL=
